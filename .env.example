# ==============================================================================
# Raiwall environment template
# ==============================================================================
# Copy to `.env` (Compose reads it automatically) and set real values:
#
#   cp .env.example .env
#
# POSTGRES_PASSWORD, RAIWALL_HMAC_SECRET and RAIWALL_POW_SECRET are required;
# the stack refuses to start without them. Everything else is optional. Prefer Docker/Kubernetes secret files by
# appending `_FILE` to any secret variable (e.g. RAIWALL_ADMIN_PASSWORD_FILE).
# ==============================================================================

# --- PostgreSQL (bundled Compose service) ------------------------------------
POSTGRES_DB=raiwall
POSTGRES_USER=postgres
# Required. Generate: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
POSTGRES_DATA_DIR=./data/postgres

# --- Gateway ports -----------------------------------------------------------
RAIWALL_HTTP_PORT=8080
RAIWALL_HTTPS_PORT=8443

# --- Control plane -----------------------------------------------------------
# Shared DSN for control + telemetry. Compose overrides this with the Postgres
# URL above; leave it unset to use the embedded SQLite default.
# RAIWALL_DATABASE_URL=postgres://postgres:change-me-in-production@postgres:5432/raiwall?sslmode=disable

RAIWALL_ADMIN_USERNAME=admin
# Leave empty to generate a random password and print it once at startup.
RAIWALL_ADMIN_PASSWORD=

# Required. Keys session token hashes; keep it stable across restarts.
# Generate with: openssl rand -hex 32
RAIWALL_HMAC_SECRET=

# Required. Signs stateless PoW challenges.
# Generate with: openssl rand -hex 32
RAIWALL_POW_SECRET=

# --- Production TLS (docker-compose.prod.yml) --------------------------------
# The dashboard/API origin; must match the host browser requests use.
# RAIWALL_PUBLIC_URL=https://raiwall.example.com
# ACME account email for automatic certificates.
# RAIWALL_ACME_EMAIL=ops@example.com

# --- Optional integrations ---------------------------------------------------
# RAIWALL_LOG_LEVEL=info
# RAIWALL_ACME_EMAIL=ops@example.com
# RAIWALL_RATE_REDIS_ADDR=redis:6379
# RAIWALL_ALERT_WEBHOOK=slack://token@channel
# RAIWALL_OIDC_ISSUER=https://idp.example.com
# RAIWALL_OIDC_CLIENT_ID=raiwall
# RAIWALL_OIDC_CLIENT_SECRET=

# --- GeoIP (Geo Location map) ------------------------------------------------
# MaxMind licence key used by geoip.auto_update to fetch GeoLite2 databases into
# ./data/geoip on boot. Create one at https://www.maxmind.com/en/geolite2/signup
# RAIWALL_GEOIP_LICENSE_KEY=
# Or point at a mounted secret file:
# RAIWALL_GEOIP_LICENSE_KEY_FILE=/run/secrets/maxmind_license_key
