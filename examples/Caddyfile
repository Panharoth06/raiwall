{
	admin off
	auto_https off
	storage file_system /var/lib/raiwall/certmagic
}

# Shared gateway handler imported by both the HTTP and HTTPS listeners.
(raiwall_site) {
	raiwall {
		mode defense
		block_status 403
		offline_status 503
		strip_headers Server X-Powered-By X-AspNet-Version
		ast_timeout 5ms
		max_param_size 32768
		bot_defense defense
		pow_difficulty 50000
		clearance_ttl 2h
		honeypot true

		rate_limit {
			tier1_velocity 100 10s 20
			tier2_attack 10 60s 24h
			tier3_scanner 20 30s 24h
			storage memory
		}

		waiting_room {
			max_concurrent 500
			max_queue_depth 1000
			admission_rate 50
			token_ttl 15m
		}

		exceptions {
			rule "allow_search_query" {
				host "example.com"
				path "/search"
				method "GET"
				location "query"
				param "q"
				rule_id "SEMANTIC_SQLI"
			}
			rule "allow_webhook_payload" {
				path_prefix "/webhooks/"
				method "POST"
				location "body"
				param "*"
				rule_id "*"
			}
		}

		acl {
			threat_feed emerging_threats examples/feeds/emerging_threats.txt
			geoip_country_db /usr/share/GeoIP/GeoLite2-Country.mmdb
			geoip_asn_db /usr/share/GeoIP/GeoLite2-ASN.mmdb

			rule "block_threat_intel" {
				expr "in_feed(client_ip, 'emerging_threats')"
				action block
				priority 10
				status_code 403
			}

			rule "geo_fence_high_risk" {
				expr "geo.country in ['KP', 'IR', 'SY']"
				action block
				priority 20
				status_code 403
			}

			rule "redirect_legacy_portal" {
				expr "has_prefix(path, '/old-portal')"
				action redirect
				priority 30
				status_code 301
				redirect_url "/portal"
			}
		}

		auth {
			provider simple
			user admin "$2a$10$wT8KzQh0XbVwB4hL0zC1..exampleHashHere" admin,ops
			session_secret "super-secure-32-byte-secret-key-123"
			session_ttl 24h
			session_cookie "rw_session"
			bypass_path /public/* /healthz /.well-known/*
		}

		telemetry {
			storage sqlite /var/lib/raiwall/telemetry.db
			flush_interval 500ms
			buffer_size 10000
			retention 720h
			alert ops_slack https://hooks.slack.com/services/T00/B00/X00 {
				events block ban critical
				cooldown 5m
			}
			alert ops_discord https://discord.com/api/webhooks/123/abc {
				events critical
				cooldown 10m
			}
		}
	}

	# Optional: Static reverse proxy fallback if not managing upstreams in Web UI.
	# When managing upstreams via the Web UI (Applications -> Add Protected Site),
	# leave this omitted; Raiwall dynamically routes to your configured backends.
	#
	# reverse_proxy 127.0.0.1:9001 127.0.0.1:9002 {
	# 	lb_policy weighted_round_robin 3 1
	# }
}

# Plain HTTP listener (admin console + HTTP gateway traffic).
:8080 {
	import raiwall_site
}

# HTTPS listener with dynamic SNI certificates managed by the control plane.
# The get_certificate module serves uploaded/self-signed certificates directly
# and lets Caddy's ACME automation issue and renew everything else.
:8443 {
	tls {
		get_certificate raiwall
	}
	import raiwall_site
}
