{
	admin off
	auto_https off
}

:8080 {
	raiwall {
		mode defense
		block_status 403
		offline_status 503
		strip_headers Server X-Powered-By X-AspNet-Version
	}

	reverse_proxy 127.0.0.1:9001 127.0.0.1:9002 {
		lb_policy round_robin
		health_uri /healthz
		health_interval 2s
		health_timeout 1s
		health_status 200
	}
}
